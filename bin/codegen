#!/usr/bin/env php
<?php

declare(strict_types=1);

/**
 * bin/codegen — emits src/RolePermissions.php for this SDK from the
 * permission-contract JSON file.
 *
 * Usage:
 *   php bin/codegen <path-to-permissions.json> > src/RolePermissions.php
 *
 * The permission-contract repo ships the canonical permissions.json.
 * The CI pipeline fetches the contract at a pinned version, runs
 * the Node emitter (scripts/codegen-php.mjs — source of truth),
 * and diffs the output against the committed RolePermissions.php.
 *
 * This PHP emitter is a self-hosted alternative for environments
 * without Node. Output is byte-for-byte equivalent to the Node
 * emitter modulo the regeneration header.
 */

if ($argc !== 2) {
    fwrite(STDERR, "usage: codegen <path-to-permissions.json>\n");
    exit(2);
}
$path = $argv[1];
$raw = @file_get_contents($path);
if ($raw === false) {
    fwrite(STDERR, "read {$path}: failed\n");
    exit(1);
}
$contract = json_decode($raw, true, 512, JSON_THROW_ON_ERROR);

$version = $contract['version'] ?? null;
if (!is_string($version) || $version === '') {
    fwrite(STDERR, "contract: missing version\n");
    exit(1);
}

$services = $contract['services'] ?? [];
$roles = $contract['roles'] ?? [];
$permissions = $contract['permissions'] ?? [];
$rolePerms = $contract['role_permissions'] ?? [];

if (!is_array($services) || !is_array($roles) || !is_array($permissions) || !is_array($rolePerms)) {
    fwrite(STDERR, "contract: malformed\n");
    exit(1);
}

$allPerms = [];
foreach ($permissions as $perms) {
    foreach ($perms as $p) {
        $allPerms[] = $p;
    }
}
sort($allPerms, SORT_STRING);

$permCaseName = static function (string $perm): string {
    $out = '';
    foreach (explode(':', $perm) as $seg) {
        $out .= ucfirst($seg);
    }
    return str_replace('-', '_', $out);
};
$roleCaseName = static function (string $role): string {
    return ucfirst(strtolower($role));
};

$buf = '';
$buf .= "<?php\n";
$buf .= "/**\n";
$buf .= " * Code generated by permission-contract/codegen-php.mjs DO NOT EDIT.\n";
$buf .= " *\n";
$buf .= " * Source: permission-contract v{$version}\n";
$buf .= " * Generated at: " . date('Y-m-d') . "\n";
$buf .= " * Regenerate via: node scripts/codegen-php.mjs permissions.json > RolePermissions.php\n";
$buf .= " *\n";
$buf .= " * The Permission enum and ROLE_PERMISSIONS map are derived from the\n";
$buf .= " * language-agnostic JSON contract. To change the platform's role → permission\n";
$buf .= " * matrix, edit permissions.json in wazobiatech/permission-contract and re-run\n";
$buf .= " * codegen — do not edit this file by hand.\n";
$buf .= " *\n";
$buf .= " * Permission naming convention: {service}:{resource}:{action}.\n";
$buf .= " *   service  — one of: " . implode(', ', $services) . "\n";
$buf .= " *   resource — domain noun (project, users, posts, members, ...)\n";
$buf .= " *   action   — verb (view, write, delete, manage, ...)\n";
$buf .= " */\n";
$buf .= "\n";
$buf .= "declare(strict_types=1);\n";
$buf .= "\n";
$buf .= "namespace Wazobia\\HeliosPermissions;\n";
$buf .= "\n";
$buf .= "/**\n";
$buf .= " * Role — closed enum of platform roles. Backed by the same string values\n";
$buf .= " * that Helios's Prisma RoleType enum stores. A role not listed here is\n";
$buf .= " * a typo and will fail to compile against the enum.\n";
$buf .= " */\n";
$buf .= "enum Role: string\n";
$buf .= "{\n";
foreach ($roles as $r) {
    $buf .= "    case {$roleCaseName($r)} = '{$r}';\n";
}
$buf .= "}\n";
$buf .= "\n";
$buf .= "/**\n";
$buf .= " * Permission — closed enum of every permission in the platform.\n";
$buf .= " * Compile-time guard: a perm not listed here is a typo.\n";
$buf .= " */\n";
$buf .= "enum Permission: string\n";
$buf .= "{\n";
foreach ($allPerms as $p) {
    $buf .= "    case {$permCaseName($p)} = '{$p}';\n";
}
$buf .= "}\n";
$buf .= "\n";
$buf .= "/**\n";
$buf .= " * RolePermissions — the canonical role → permission map plus the\n";
$buf .= " * three helpers. Mirrors the TS / Go SDKs' role_permissions.* files.\n";
$buf .= " *\n";
$buf .= " * Contract invariants (enforced by permission-contract/scripts/validate.mjs):\n";
$buf .= " *   - helios:tenant:switch is present in every role (universal perm).\n";
$buf .= " *   - helios:tenant:transfer is present only in OWNER (ZIN-4714).\n";
$buf .= " *   - Every role has >= 1 permission.\n";
$buf .= " *   - No role references a perm outside the vocabulary.\n";
$buf .= " */\n";
$buf .= "final class RolePermissions\n";
$buf .= "{\n";
$buf .= "    /** @var list<Role> */\n";
$buf .= "    public const ROLES = [\n";
foreach ($roles as $r) {
    $buf .= "        Role::{$roleCaseName($r)},\n";
}
$buf .= "    ];\n";
$buf .= "\n";
$buf .= "    /** @var array<string, list<Permission>> */\n";
$buf .= "    private const ROLE_PERMISSIONS = [\n";
foreach ($roles as $r) {
    $perms = $rolePerms[$r]['permissions'] ?? [];
    sort($perms, SORT_STRING);
    $buf .= "        '{$r}' => [\n";
    foreach ($perms as $p) {
        $buf .= "            Permission::{$permCaseName($p)},\n";
    }
    $buf .= "        ],\n";
}
$buf .= "    ];\n";
$buf .= "\n";
$buf .= "    /**\n";
$buf .= "     * Resolve the permission set for \$role. Returns an empty list for\n";
$buf .= "     * unknown roles (defensive — callers should be using the typed\n";
$buf .= "     * Role enum, but a runtime string from an untrusted source might\n";
$buf .= "     * not be).\n";
$buf .= "     *\n";
$buf .= "     * @return list<Permission>\n";
$buf .= "     */\n";
$buf .= "    public static function resolve(Role \$role): array\n";
$buf .= "    {\n";
$buf .= "        \$perms = self::ROLE_PERMISSIONS[\$role->value] ?? [];\n";
$buf .= "        return array_values(\$perms);\n";
$buf .= "    }\n";
$buf .= "\n";
$buf .= "    /**\n";
$buf .= "     * @return list<string>\n";
$buf .= "     */\n";
$buf .= "    public static function resolveStringValues(Role \$role): array\n";
$buf .= "    {\n";
$buf .= "        \$perms = self::resolve(\$role);\n";
$buf .= "        return array_map(static fn (Permission \$p) => \$p->value, \$perms);\n";
$buf .= "    }\n";
$buf .= "\n";
$buf .= "    /**\n";
$buf .= "     * @return list<Permission>\n";
$buf .= "     */\n";
$buf .= "    public static function resolveAllForRoles(): array\n";
$buf .= "    {\n";
$buf .= "        \$all = [];\n";
$buf .= "        foreach (self::ROLES as \$r) {\n";
$buf .= "            foreach (self::resolve(\$r) as \$p) {\n";
$buf .= "                \$all[\$p->value] = \$p;\n";
$buf .= "            }\n";
$buf .= "        }\n";
$buf .= "        return array_values(\$all);\n";
$buf .= "    }\n";
$buf .= "\n";
$buf .= "    public static function has(Role \$role, Permission \$perm): bool\n";
$buf .= "    {\n";
$buf .= "        return in_array(\$perm, self::resolve(\$role), true);\n";
$buf .= "    }\n";
$buf .= "\n";
$buf .= "    public static function isValidPermission(Permission \$perm): bool\n";
$buf .= "    {\n";
$buf .= "        return in_array(\$perm, self::resolveAllForRoles(), true);\n";
$buf .= "    }\n";
$buf .= "}\n";

echo $buf;
