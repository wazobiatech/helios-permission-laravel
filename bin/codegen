#!/usr/bin/env php
<?php

declare(strict_types=1);

/**
 * bin/codegen — emits the four generated PHP files for this SDK from
 * the permission-contract JSON file:
 *
 *   src/Role.php            — closed Role enum
 *   src/Permission.php      — closed Permission enum
 *   src/PermScope.php       — closed PermScope enum (v1.3.0+)
 *   src/RolePermissions.php — role → perm map + scope helpers + PERM_SCOPE
 *
 * Usage:
 *   php bin/codegen <path-to-permissions.json> <out-dir>
 *
 * The permission-contract repo ships the canonical permissions.json.
 * The CI pipeline fetches the contract at a pinned version, runs the
 * Node emitter (scripts/codegen-php.mjs — source of truth), and
 * diffs the output against the committed files. Drift fails the build.
 *
 * This PHP emitter is a self-hosted alternative for environments
 * without Node. Output is byte-for-byte equivalent to the Node emitter
 * modulo the regeneration header.
 *
 * v1.3.0 contract — perms are {name, scope} objects (4 scopes: self,
 * platform, project, platform/project). Buckets feed SELF_PERMISSIONS,
 * PLATFORM_PERMISSIONS, PROJECT_PERMISSIONS, DUAL_PERMISSIONS, plus
 * PERM_SCOPE (string → PermScope lookup).
 */

if ($argc !== 3) {
    fwrite(STDERR, "usage: codegen <path-to-permissions.json> <out-dir>\n");
    exit(2);
}

[$_, $contractPath, $outDir] = $argv;

$raw = @file_get_contents($contractPath);
if ($raw === false) {
    fwrite(STDERR, "read {$contractPath}: failed\n");
    exit(1);
}

try {
    $contract = json_decode($raw, true, 512, JSON_THROW_ON_ERROR);
} catch (\JsonException $e) {
    fwrite(STDERR, "parse {$contractPath}: {$e->getMessage()}\n");
    exit(1);
}

$version = $contract['version'] ?? null;
if (!is_string($version) || $version === '') {
    fwrite(STDERR, "contract: missing version\n");
    exit(1);
}

$services = $contract['services'] ?? null;
$roles = $contract['roles'] ?? null;
$permissions = $contract['permissions'] ?? null;
$rolePerms = $contract['role_permissions'] ?? null;
if (!is_array($services) || !is_array($roles) || !is_array($permissions) || !is_array($rolePerms)) {
    fwrite(STDERR, "contract: malformed (services/roles/permissions/role_permissions)\n");
    exit(1);
}

// Flatten and bucket by scope. Preserve contract-declared service order
// (matches the JSON contract.permissions key order).
$selfPerms = [];
$platformPerms = [];
$projectPerms = [];
$dualPerms = [];
$allPerms = []; // alphabetical by name, {name, caseName}
foreach ($services as $svc) {
    foreach ($permissions[$svc] ?? [] as $p) {
        if (!is_array($p) || !isset($p['name'], $p['scope'])) {
            fwrite(STDERR, "permissions[{$svc}] has malformed perm (v1.3.0 requires {name, scope} objects)\n");
            exit(1);
        }
        $name = $p['name'];
        $scope = $p['scope'];
        $caseName = permCaseName($name);
        $allPerms[] = ['name' => $name, 'caseName' => $caseName, 'scope' => $scope];
        switch ($scope) {
            case 'self':
                $selfPerms[] = ['name' => $name, 'caseName' => $caseName];
                break;
            case 'platform':
                $platformPerms[] = ['name' => $name, 'caseName' => $caseName];
                break;
            case 'project':
                $projectPerms[] = ['name' => $name, 'caseName' => $caseName];
                break;
            case 'platform/project':
                $dualPerms[] = ['name' => $name, 'caseName' => $caseName];
                break;
            default:
                fwrite(STDERR, "perm {$name}: invalid scope {$scope}\n");
                exit(1);
        }
    }
}

usort($allPerms, static fn ($a, $b) => strcmp($a['name'], $b['name']));

// Per-role perm lists (alphabetical for diff stability).
$roleData = [];
foreach ($roles as $r) {
    $perms = $rolePerms[$r]['permissions'] ?? [];
    sort($perms, SORT_STRING);
    $roleData[$r] = $perms;
}

$generatedAt = date('Y-m-d');

$roleHeader = headerBlock(
    $version,
    $generatedAt,
    $services,
    "Role — closed enum of platform roles. Backed by the same string values\n"
    . " * Helios's Prisma RoleType uses. New roles must be added to the contract's\n"
    . " * roles[] array and the codegen re-run."
);

$permHeader = headerBlock(
    $version,
    $generatedAt,
    $services,
    "Permission — closed enum of every permission string in the platform.\n"
    . " * PHP 8.1 backed enums give compile-time typo protection: a perm not\n"
    . " * listed here fails the type checker."
);

$scopeHeader = headerBlock(
    $version,
    $generatedAt,
    $services,
    "PermScope — closed enum of valid permission scopes. Mirrors the\n"
    . " * contract's scope enum. v1.3.0+.\n"
    . " *\n"
    . " * Scope semantics:\n"
    . " *   self              — universal, granted implicitly to every user\n"
    . " *   platform          — granted via ROLE_PERMISSIONS (platform-user path)\n"
    . " *   project           — granted via TenantRole (tenant-user path)\n"
    . " *   platform/project  — valid via either path"
);

$rpHeader = headerBlock(
    $version,
    $generatedAt,
    $services,
    "RolePermissions — canonical role → permission map, scope lookup, and helpers.\n"
    . " *\n"
    . " * Mirrors the TS / Python / Go SDKs. Every role lists its permissions\n"
    . " * explicitly — no inheritance. The contract validator\n"
    . " * (scripts/validate.mjs) enforces:\n"
    . " *   - helios:tenant:switch:self is present as a self-scope perm (universal).\n"
    . " *   - helios:tenant:transfer is OWNER-only (platform scope).\n"
    . " *   - Every role has >= 1 permission.\n"
    . " *   - No role references a perm outside the vocabulary.\n"
    . " *   - No self or project perms in any role."
);

// === Role.php ===
$roleLines = [];
$roleLines[] = $roleHeader;
$roleLines[] = 'enum Role: string';
$roleLines[] = '{';
foreach ($roles as $r) {
    $roleLines[] = '    case ' . roleCaseName($r) . " = '{$r}';";
}
$roleLines[] = '}';
$roleLines[] = '';
$rolePhp = implode("\n", $roleLines);

// === Permission.php ===
$permLines = [];
$permLines[] = $permHeader;
$permLines[] = 'enum Permission: string';
$permLines[] = '{';
foreach ($allPerms as $p) {
    $permLines[] = "    case {$p['caseName']} = '{$p['name']}';";
}
$permLines[] = '}';
$permLines[] = '';
$permPhp = implode("\n", $permLines);

// === PermScope.php ===
$scopeLines = [];
$scopeLines[] = $scopeHeader;
$scopeLines[] = 'enum PermScope: string';
$scopeLines[] = '{';
$scopeLines[] = "    case Self = 'self';";
$scopeLines[] = "    case Platform = 'platform';";
$scopeLines[] = "    case Project = 'project';";
$scopeLines[] = "    case PlatformProject = 'platform/project';";
$scopeLines[] = '}';
$scopeLines[] = '';
$scopePhp = implode("\n", $scopeLines);

// === RolePermissions.php ===
$rpLines = [];
$rpLines[] = $rpHeader;
$rpLines[] = 'final class RolePermissions';
$rpLines[] = '{';
$rpLines[] = "    /** Every role in the platform. Same order as the contract's roles[]. */";
$rpLines[] = '    public const ROLES = [';
foreach ($roles as $r) {
    $rpLines[] = '        Role::' . roleCaseName($r) . ',';
}
$rpLines[] = '    ];';
$rpLines[] = '';
$rpLines[] = '    /**';
$rpLines[] = '     * @var array<string, list<Permission>> role → perm map.';
$rpLines[] = '     *';
$rpLines[] = "     * Only contains platform and platform/project perms;";
$rpLines[] = "     * self perms are universal (granted by the resolver's Step 1)";
$rpLines[] = '     * and project perms are for tenant users via TenantRole.';
$rpLines[] = '     */';
$rpLines[] = '    private const ROLE_PERMISSIONS = [';
foreach ($roles as $r) {
    $rpLines[] = "        '{$r}' => [";
    foreach ($roleData[$r] as $p) {
        $rpLines[] = '            Permission::' . permCaseName($p) . ',';
    }
    $rpLines[] = '        ],';
}
$rpLines[] = '    ];';
$rpLines[] = '';
$rpLines[] = '    /**';
$rpLines[] = '     * @var array<string, PermScope> perm → scope lookup. Populated at module';
$rpLines[] = '     * load. The two-track resolver in Helios checks PERM_SCOPE[perm] to';
$rpLines[] = '     * decide which path (platform-user vs tenant-user) is valid.';
$rpLines[] = '     */';
$rpLines[] = '    public const PERM_SCOPE = [';
foreach ($selfPerms as $p) {
    $rpLines[] = "        '{$p['name']}' => PermScope::Self,";
}
foreach ($platformPerms as $p) {
    $rpLines[] = "        '{$p['name']}' => PermScope::Platform,";
}
foreach ($projectPerms as $p) {
    $rpLines[] = "        '{$p['name']}' => PermScope::Project,";
}
foreach ($dualPerms as $p) {
    $rpLines[] = "        '{$p['name']}' => PermScope::PlatformProject,";
}
$rpLines[] = '    ];';
$rpLines[] = '';
$rpLines[] = '    /**';
$rpLines[] = '     * Return the permission array for a role. Empty for unknown roles.';
$rpLines[] = '     *';
$rpLines[] = '     * @return list<Permission>';
$rpLines[] = '     */';
$rpLines[] = '    public static function resolve(Role $role): array';
$rpLines[] = '    {';
$rpLines[] = '        return self::ROLE_PERMISSIONS[$role->value] ?? [];';
$rpLines[] = '    }';
$rpLines[] = '';
$rpLines[] = '    /**';
$rpLines[] = '     * True if role is granted perm. Both args must be typed enums — a typo';
$rpLines[] = '     * in a perm string will not satisfy the Permission type.';
$rpLines[] = '     */';
$rpLines[] = '    public static function has(Role $role, Permission $perm): bool';
$rpLines[] = '    {';
$rpLines[] = '        foreach (self::resolve($role) as $p) {';
$rpLines[] = '            if ($p === $perm) {';
$rpLines[] = '                return true;';
$rpLines[] = '            }';
$rpLines[] = '        }';
$rpLines[] = '        return false;';
$rpLines[] = '    }';
$rpLines[] = '';
$rpLines[] = '    /**';
$rpLines[] = '     * True if p is a known Permission value. Used for runtime validation of';
$rpLines[] = '     * strings arriving from an untrusted source (request bodies, DB rows, etc).';
$rpLines[] = '     */';
$rpLines[] = '    public static function isValidPermission(Permission $perm): bool';
$rpLines[] = '    {';
$rpLines[] = '        return in_array($perm, Permission::cases(), true);';
$rpLines[] = '    }';
$rpLines[] = '';
$rpLines[] = '    /**';
$rpLines[] = '     * Return the scope of a perm, or null if the perm is tenant-defined';
$rpLines[] = '     * (not in the contract vocabulary).';
$rpLines[] = '     */';
$rpLines[] = '    public static function scopeOf(Permission $perm): ?PermScope';
$rpLines[] = '    {';
$rpLines[] = '        return self::PERM_SCOPE[$perm->value] ?? null;';
$rpLines[] = '    }';
$rpLines[] = '';
$rpLines[] = '    /**';
$rpLines[] = '     * True if perm has scope \'self\' (universal — granted without any role';
$rpLines[] = '     * lookup). Used by the resolver\'s Step 1.';
$rpLines[] = '     */';
$rpLines[] = '    public static function isSelfScope(Permission $perm): bool';
$rpLines[] = '    {';
$rpLines[] = '        return self::scopeOf($perm) === PermScope::Self;';
$rpLines[] = '    }';
$rpLines[] = '';
$rpLines[] = '    /**';
$rpLines[] = '     * True if perm is grantable via the platform-user path (scope is';
$rpLines[] = '     * \'platform\' or \'platform/project\').';
$rpLines[] = '     */';
$rpLines[] = '    public static function isPlatformGrantable(Permission $perm): bool';
$rpLines[] = '    {';
$rpLines[] = '        $s = self::scopeOf($perm);';
$rpLines[] = '        return $s === PermScope::Platform || $s === PermScope::PlatformProject;';
$rpLines[] = '    }';
$rpLines[] = '';
$rpLines[] = '    /**';
$rpLines[] = '     * True if perm is grantable via the tenant-user path. Scope \'project\'';
$rpLines[] = '     * and \'platform/project\' are grantable. Any perm NOT in PERM_SCOPE is';
$rpLines[] = '     * treated as tenant-defined and therefore grantable via TenantRole.';
$rpLines[] = '     */';
$rpLines[] = '    public static function isTenantGrantable(string $perm): bool';
$rpLines[] = '    {';
$rpLines[] = '        if (!isset(self::PERM_SCOPE[$perm])) {';
$rpLines[] = '            return true;';
$rpLines[] = '        }';
$rpLines[] = '        $s = self::PERM_SCOPE[$perm];';
$rpLines[] = '        return $s === PermScope::Project || $s === PermScope::PlatformProject;';
$rpLines[] = '    }';
$rpLines[] = '}';
$rpLines[] = '';
$rpPhp = implode("\n", $rpLines);

if (!is_dir($outDir)) {
    if (!mkdir($outDir, 0o755, true) && !is_dir($outDir)) {
        fwrite(STDERR, "mkdir {$outDir}: failed\n");
        exit(1);
    }
}

file_put_contents($outDir . '/Role.php', $rolePhp);
file_put_contents($outDir . '/Permission.php', $permPhp);
file_put_contents($outDir . '/PermScope.php', $scopePhp);
file_put_contents($outDir . '/RolePermissions.php', $rpPhp);

fwrite(STDOUT, "wrote {$outDir}/Role.php\n");
fwrite(STDOUT, "wrote {$outDir}/Permission.php\n");
fwrite(STDOUT, "wrote {$outDir}/PermScope.php\n");
fwrite(STDOUT, "wrote {$outDir}/RolePermissions.php\n");

/**
 * Render the standard file header used by all 4 generated files.
 */
function headerBlock(string $version, string $generatedAt, array $services, string $extraComment): string
{
    return "<?php\n"
        . "/**\n"
        . " * Code generated by permission-contract/codegen-php.mjs DO NOT EDIT.\n"
        . " *\n"
        . " * Source: permission-contract v{$version}\n"
        . " * Generated at: {$generatedAt}\n"
        . " * Regenerate via: node scripts/codegen-php.mjs permissions.json <out-dir>\n"
        . " *\n"
        . " * {$extraComment}\n"
        . " *\n"
        . " * Permission naming convention: {service}:{resource}:{action}.\n"
        . " *   service  — one of: " . implode(', ', $services) . "\n"
        . " *   resource — domain noun (project, users, posts, members, ...)\n"
        . " *   action   — verb (view, write, delete, manage, ...)\n"
        . " */\n"
        . "\n"
        . "declare(strict_types=1);\n"
        . "\n"
        . "namespace Wazobia\\HeliosPermissions;\n";
}

/**
 * Pascal-case a perm string. "athens:project:view" → "AthensProjectView".
 * Preserves underscores and the rest of each segment verbatim (no toLower).
 */
function permCaseName(string $perm): string
{
    $out = '';
    foreach (explode(':', $perm) as $seg) {
        $out .= ucfirst($seg);
    }
    return $out;
}

/**
 * Pascal-case a role string. "OWNER" → "Owner".
 */
function roleCaseName(string $role): string
{
    return ucfirst(strtolower($role));
}