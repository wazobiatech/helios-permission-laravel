{
    "name": "wazobia/helios-permissions",
    "description": "Laravel SDK for the Wazobia Tech platform's cross-service authorization. Cache-first callerHasPermission backed by a shared Redis.",
    "type": "library",
    "license": "proprietary",
    "version": "0.1.0",
    "require": {
        "php": "^8.1",
        "predis/predis": "^2.2",
        "illuminate/http": "^10.0|^11.0|^12.0",
        "illuminate/support": "^10.0|^11.0|^12.0"
    },
    "require-dev": {
        "phpunit/phpunit": "^10.0",
        "mockery/mockery": "^1.6"
    },
    "autoload": {
        "psr-4": {
            "Wazobia\\HeliosPermissions\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Wazobia\\HeliosPermissions\\Tests\\": "tests/"
        }
    },
    "extra": {
        "laravel": {
            "providers": [
                "Wazobia\\HeliosPermissions\\HeliosPermissionsServiceProvider"
            ]
        }
    },
    "minimum-stability": "stable",
    "prefer-stable": true,
    "config": {
        "sort-packages": true,
        "audit": {
            "abandoned": "ignore"
        }
    }
}
